[Unit]
Description=Redis data structure server

[Service]
Type=simple
ExecStart=/bin/sh -lc 'data=$REDIS_DATA_DIR; [ -n "$data" ] || data=%S/redis; mkdir -p "$data"; exec /usr/bin/redis-server --bind 127.0.0.1 --port 6379 --dir "$data" --daemonize no'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
