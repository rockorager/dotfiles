[Unit]
Description=Set keywork shell background
After=keywork-shell.service
Requires=keywork-shell.service
PartOf=keywork-shell.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/keywork-shell background --image %h/.local/share/backgrounds/keywork-wave.png --mode stretch
RemainAfterExit=yes
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sway-session.target
