#!/bin/sh

# Cache `op read` results in a user-private runtime cache.
# This avoids repeated slow 1Password CLI reads without putting secrets in shell startup files.

if [ "$#" -ne 2 ] || [ "$1" != read ]; then
    echo "Usage: $0 read op://some/path" >&2
    exit 1
fi

url=$2
cache_base=${XDG_RUNTIME_DIR:-$HOME/.cache}
cache_dir=$cache_base/opcache
cache_key=$(printf '%s' "$url" | sha256sum | awk '{print $1}')
cache_file=$cache_dir/$cache_key

umask 077
mkdir -p "$cache_dir"
chmod 700 "$cache_dir"

if [ -f "$cache_file" ]; then
    cat "$cache_file"
    exit 0
fi

tmp_file=$(mktemp "$cache_dir/.tmp.XXXXXX") || exit 1
if op read "$url" >"$tmp_file"; then
    mv "$tmp_file" "$cache_file"
else
    status=$?
    rm -f "$tmp_file"
    exit "$status"
fi

cat "$cache_file"
