#!/bin/sh

selection=$(
    printf 'Logout\000icon\037system-log-out-symbolic\nRestart\000icon\037system-reboot-symbolic\nShutdown\000icon\037system-shutdown-symbolic\n' |
        fuzzel \
            --dmenu \
            --lines=4 \
            --width=16
)

case $selection in
    Logout)
        loginctl terminate-user "$USER"
        ;;
    *Restart*)
        systemctl reboot
        ;;
    *Shutdown*)
        systemctl poweroff
        ;;
esac
