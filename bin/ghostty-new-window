#!/bin/sh

focused_app_id=$(swaymsg -t get_tree 2>/dev/null | jq -r '
    .. | objects | select(.focused? == true) |
    .app_id // .window_properties.class // empty
' 2>/dev/null)
focused_window_index=$(swaymsg -t get_tree 2>/dev/null | jq -r '
    [.. | objects | select(.app_id? == "com.mitchellh.ghostty") | .id] as $windows |
    (.. | objects | select(.focused? == true) | .id) as $focused |
    ($windows | sort | index($focused)) // empty
' 2>/dev/null)

case "$focused_app_id" in
    com.mitchellh.ghostty|com.mitchellh.ghostty-debug)
        ghostty_window_path=$(gdbus introspect \
            --session \
            --dest com.mitchellh.ghostty \
            --object-path /com/mitchellh/ghostty/window 2>/dev/null | \
            awk '/node [0-9]+/ { gsub(/[{};]/, "", $2); print $2 }' | \
            sort -n | \
            awk -v idx="$focused_window_index" 'NR == idx + 1 { print "/com/mitchellh/ghostty/window/" $1 }')

        if [ -n "$ghostty_window_path" ] && gdbus call \
            --session \
            --dest com.mitchellh.ghostty \
            --object-path "$ghostty_window_path" \
            --method org.gtk.Actions.Activate \
            new-window \
            "[]" \
            "{}" >/dev/null 2>&1
        then
            exit 0
        fi
        ;;
esac

if command -v ghostty >/dev/null 2>&1; then
    exec ghostty +new-window --working-directory=home "$@"
fi

exec ghostty
