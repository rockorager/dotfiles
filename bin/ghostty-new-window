#!/bin/sh

focused_app_id=$(swaymsg -t get_tree 2>/dev/null | jq -r '
    .. | objects | select(.focused? == true) |
    .app_id // .window_properties.class // empty
' 2>/dev/null)
focused_name=$(swaymsg -t get_tree 2>/dev/null | jq -r '
    .. | objects | select(.focused? == true) |
    .name // empty
' 2>/dev/null)

case "$focused_app_id" in
    com.mitchellh.ghostty|com.mitchellh.ghostty-debug)
        working_directory=${focused_name##* - }

        case "$working_directory" in
            '~') working_directory=$HOME ;;
            '~/'*) working_directory=$HOME/${working_directory#\~/} ;;
        esac

        if [ -d "$working_directory" ]; then
            exec ghostty +new-window --working-directory="$working_directory" "$@"
        fi
        ;;
esac

if command -v ghostty >/dev/null 2>&1; then
    exec ghostty +new-window --working-directory=home "$@"
fi

exec ghostty
