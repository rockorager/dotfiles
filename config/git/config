[init]
  defaultBranch = main

[user]
  name = Tim Culverhouse
  email = tim@timculverhouse.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII1zDktVjP0FPs1o7fsgYwVZML4b8WnsQKlGMWSqXOsM

[commit]
  verbose = true
  gpgsign = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[log]
  decorate = true
  follow = true

[pull]
  rebase = true

[rebase]
  autosquash = true

[core]
  abbrev = 12

[pager]
  diff = comview
  show = comview

[rerere]
  enabled = true

[alias]
  lo = log --oneline
  co = checkout
  cob = checkout -b

[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
