# Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $accent #c0caf5

client.focused $accent $accent $accent $accent
default_border pixel 2
smart_borders on

input "type:touchpad" {
	dwt enabled
	click_method clickfinger
	tap enabled
	natural_scroll disabled
	scroll_factor 0.3
}

input "type:pointer" {
	pointer_accel -0.25
}

input "type:keyboard" {
	repeat_delay 180
	repeat_rate 60
	xkb_layout us
}

# Let kanshi own output layout, and reapply it after Sway reloads.
exec_always systemctl --user restart kanshi.service

### Key bindings

# Programs
bindsym $mod+Return exec monstar
bindsym $mod+p exec /usr/bin/1password --quick-access
bindsym $mod+Space exec keywork-shell launcher
bindsym $mod+q kill

bindsym Print exec grimshot save anything - | gradia

# Window rules
for_window [app_id="float"] floating enable
for_window [app_id="be.alexandervanhee.gradia"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="zoom"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="slack" title="^Huddle:"] floating enable, sticky enable
for_window [app_id="firefox"] inhibit_idle fullscreen
for_window [app_id="polkit-gnome-authentication-agent-1"] floating enable; border none

# Window manipulation
floating_modifier $mod normal
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle

# Misc
bindsym $mod+Shift+e exec powermenu
bindsym $mod+Shift+c reload

# Notifications
bindsym $mod+n exec mako-activate
bindsym $mod+Shift+n exec makoctl dismiss
bindsym $mod+Ctrl+n exec makoctl restore

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Brightness
bindsym --locked XF86MonBrightnessDown exec swayosd-client --brightness -5
bindsym --locked XF86MonBrightnessUp exec swayosd-client --brightness +5
bindsym --locked XF86KbdBrightnessUp   exec brightnessctl --device='tpacpi::kbd_backlight' set 20%+
bindsym --locked XF86KbdBrightnessDown exec brightnessctl --device='tpacpi::kbd_backlight' set 20%-

# Volume
bindsym --locked XF86AudioMute exec swayosd-client --output-volume mute-toggle --max-volume 100
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-mute @DEFAULT_SINK@ 0 && swayosd-client --output-volume -5 --max-volume 100
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-mute @DEFAULT_SINK@ 0 && swayosd-client --output-volume +5 --max-volume 100

# Microphone
bindsym --locked Shift+XF86AudioMute exec swayosd-client --input-volume mute-toggle
bindsym --locked Shift+XF86AudioLowerVolume exec swayosd-client --input-volume -5
bindsym --locked Shift+XF86AudioRaiseVolume exec swayosd-client --input-volume +5

# Media buttons
bindsym XF86AudioPlay exec swayosd-client --playerctl play-pause
bindsym XF86AudioNext exec swayosd-client --playerctl next
bindsym XF86AudioPrev exec swayosd-client --playerctl prev

# Lock keys
bindsym --release Caps_Lock exec swayosd-client --caps-lock

# Moving around:

# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
# Or use $mod+[up|down|left|right]
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces:

# Next workspace

bindsym alt+tab workspace back_and_forth

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# GTK
## Set default cursor theme
exec gsettings set org.gnome.desktop.interface cursor-theme Adwaita
## Set default icon theme
exec gsettings set org.gnome.desktop.interface icon-theme Adwaita
## Set default theme
exec gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
## Set prefers dark
exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'


include /etc/sway/config.d/*
