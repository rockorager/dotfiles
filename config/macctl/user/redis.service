[Unit]
Description=Redis data structure server

[Service]
ExecStart=/bin/sh -lc 'data=$REDIS_DATA_DIR; [ -n "$data" ] || data=/Users/tim/.local/state/redis; mkdir -p "$data"; exec /opt/homebrew/opt/redis/bin/redis-server --bind 127.0.0.1 --port 6379 --dir "$data" --daemonize no'
Restart=on-failure
RestartSec=2
