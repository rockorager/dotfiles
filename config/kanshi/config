profile "laptop" {
  output eDP-1 enable position 0,0 scale 1.5
}

profile "dock" {
  output DP-10  position 0,0
  output eDP-1 disable
}

profile "office" {
  output HDMI-A-1  position 0,0
  output eDP-1 disable
}

profile "acer-kg272k" {
  output "Acer Technologies KG272K L *" enable position 0,0 scale 1.25
  output eDP-1 disable
}
